  "measures": [
    {
      "id": "php-session-upload-progress",
      "title": "PHP2Shell und Folgelücke: Session-Upload-Progress aus",
      "advisory": "https://github.com/NCSC-NL/php2shell",
      "summary": "PHP2Shell (CVE-2026-109618, CVE-2026-109619, Oktober 2026) erlaubt Codeausführung ohne Anmeldung; geschlossen wird es nur durch das gepatchte PHP-Paket. Die Folgelücke CVE-2026-115560 steckt in „session upload progress“ und betrifft auch gepatchte Versionen bis zum nächsten PHP-Release. PHP empfiehlt bis dahin session.upload_progress.enabled=0 und einen Neustart der PHP-Prozesse. Nachteil nur für serverseitige Upload-Fortschrittsbalken, die $_SESSION lesen; JavaScript-Fortschrittsanzeigen funktionieren weiter. Eine Apache-Regel hilft hier nicht, weil der Angriff im Inhalt der Anfrage steckt.",
      "type": "php-ini",
      "cves": [
        "CVE-2026-109618",
        "CVE-2026-109619",
        "CVE-2026-115560"
      ],
      "match": {
        "path": ""
      },
      "php_ini": {
        "session.upload_progress.enabled": "0"
      },
      "must_block": null,
      "must_pass": [
        {
          "method": "GET",
          "target": "/"
        },
        {
          "method": "GET",
          "target": "/robots.txt"
        }
      ],
      "review": "2027-01-31"
    }
  ]
